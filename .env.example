# Local defaults only. make init copies this to ignored .env and generates APP_SECRET.
# Production: use a separate ignored .env.prod.local with real credentials.
COMPOSE_PROJECT_NAME=sport-e
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=local-placeholder-generated-by-make-init
APP_NAME="Sport E"
BUILD_VERSION=dev

POSTGRES_DB=sport_e
POSTGRES_USER=app
POSTGRES_PASSWORD=local-development-password
POSTGRES_MAX_CONNECTIONS=50
# For a local host PHP process use a private port override; Compose overrides this URL.
DATABASE_URL=postgresql://app:local-development-password@postgres:5432/sport_e?serverVersion=18&charset=utf8
DB_CONNECTION_TIMEOUT=2
DB_STATEMENT_TIMEOUT_MS=3000
REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT=1
REDIS_READ_TIMEOUT=1
REDIS_MAXMEMORY=128mb
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=false

# Storefront cache: generation-scoped SWR groups (tree/list/card) plus a
# short-lived exchange-rate pool, all backed by REDIS_URL. TTLs in seconds:
# "fresh" is the SWR serve window, "total" the hard expiry.
STOREFRONT_CACHE_ENABLED=1
STOREFRONT_CACHE_PREFIX=sport_e
STOREFRONT_CACHE_GENERATION_TTL=2592000
STOREFRONT_CACHE_TREE_FRESH_TTL=3600
STOREFRONT_CACHE_TREE_TOTAL_TTL=86400
STOREFRONT_CACHE_LIST_FRESH_TTL=300
STOREFRONT_CACHE_LIST_TOTAL_TTL=1800
STOREFRONT_CACHE_CARD_FRESH_TTL=900
STOREFRONT_CACHE_CARD_TOTAL_TTL=3600
EXCHANGE_RATE_CACHE_TTL=300
# flock covers a single host. Multi-replica production needs a shared lock
# store, e.g. LOCK_DSN=redis://redis:6379.
LOCK_DSN=flock

# External exchange-rate sources. Walutomat needs a URL + bearer token;
# the NBRB/NBP fallbacks need no configuration.
MYFIN_EUR_BYN_URL=https://myfin.by/converter/eur-byn
WALUTOMAT_EUR_PLN_URL=
WALUTOMAT_API_TOKEN=

# Mail transport for transactional identity mail. null://null drops messages
# locally; point to a real relay in .env.prod.local only.
MAILER_DSN=null://null
MAILER_FROM='Sport E <no-reply@sport-e.example>'
# Public origin used in verification/reset links — the Vite dev server proxy
# forwards /api to the backend in local development.
APP_PUBLIC_URL=http://localhost:5173

# Base64-encoded 32-byte key for SodiumFieldCipher (payment columns only).
# This is a development/test placeholder, never a production secret.
# Generate a real one with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
APP_FIELD_CIPHER_KEY=ZC1zcG9ydC1kZXYtZmllbGQtY2lwaGVyLWtleS0zMiE=

# Empty proxy list means forwarding headers are untrusted. Use exact proxy IP/CIDR later.
TRUSTED_PROXIES=
TRUSTED_HOSTS='^(localhost|127\.0\.0\.1|backend)$'
HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_HTTPS_PORT=8443
FRONTEND_PORT=5173
# Production: real DNS name; automatic ACME needs public 80/443 mappings.
SERVER_NAME=localhost
# Conservative initial values: tune against CPU/memory and database connection budget.
FRANKENPHP_WORKERS=2
FRANKENPHP_MAX_THREADS=4
PHP_MEMORY_LIMIT=128M
WEB_CPUS=1
WEB_MEMORY_LIMIT=768M
WORKER_MEMORY_LIMIT=384M
WORKER_PHP_MEMORY_LIMIT=256M
MESSENGER_TIME_LIMIT=3600
MESSENGER_MEMORY_LIMIT=128M
